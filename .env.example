# AI Sports Tracker Environment Variables

# Backend Service
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/sports-tracker

# Redis Cache & Lock Provider
# REDIS_URL=redis://default:password@railway-redis.internal:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expirations
JWT_ACCESS_SECRET=sports_tracker_super_secret_access_jwt_key_2026
JWT_REFRESH_SECRET=sports_tracker_super_secret_refresh_jwt_key_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Primary Free Sports Provider (TheSportsDB)
SPORTS_DB_API_KEY=3
SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json
SPORTS_DB_TIMEOUT_MS=5000
ENABLE_MOCK_FALLBACK=true

# Shared Portfolio Services
AI_PLATFORM_URL=http://localhost:4001
AI_PLATFORM_API_KEY=ai-platform-dev-token-2026
AI_PLATFORM_TIMEOUT_MS=10000

NOTIFICATION_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_API_KEY=notification-service-dev-token-2026
NOTIFICATION_SERVICE_TIMEOUT_MS=5000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Optional Authentication / Public Access
PUBLIC_ACCESS_ENABLED=true

# Frontend Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ACCESS_ENABLED=true
